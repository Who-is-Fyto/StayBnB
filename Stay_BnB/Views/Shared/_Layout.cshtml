@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using Stay_BnB.Data
@using Stay_BnB.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext DbContext

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Staybnb</title>
    
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    
    <!-- Custom Airbnb Theme Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Sticky Navigation Bar -->
    <header>
        <nav class="staybnb-navbar d-flex align-items-center justify-content-between">
            <!-- Brand Logo -->
            <a class="navbar-brand-logo" asp-controller="Home" asp-action="Index">
                <i class="bi bi-house-heart-fill"></i>
                <span>staybnb</span>
            </a>

            <!-- Central Search Pill -->
            <form asp-controller="Home" asp-action="Index" method="get" class="d-none d-md-flex align-items-center m-0">
                <div class="search-pill">
                    <input type="text" name="city" placeholder="Anywhere" value="@Context.Request.Query["city"]" style="width: 110px;" />
                    <span class="search-divider"></span>
                    <input type="text" name="propertyType" placeholder="Any type" value="@Context.Request.Query["propertyType"]" style="width: 90px;" />
                    <span class="search-divider"></span>
                    <span class="text-slate small me-2">Guests</span>
                    <button type="submit" class="search-btn-circle" title="Search">
                        <i class="bi bi-search" style="font-size: 0.85rem;"></i>
                    </button>
                </div>
            </form>

            <!-- Dynamic Role-Based User Menu -->
            <div class="d-flex align-items-center gap-2">
                <!-- Global Currency Switcher (Default: South African Rand ZAR) -->
                <div class="dropdown me-1">
                    <button class="btn btn-sm btn-light border rounded-pill py-1 px-2 d-flex align-items-center gap-1" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Switch Currency">
                        <i class="bi bi-cash-stack text-slate"></i>
                        <span class="fw-semibold small currency-display-label">@CurrencyService.CurrentCurrency.Code (@CurrencyService.CurrentCurrency.Symbol)</span>
                        <i class="bi bi-chevron-down text-slate" style="font-size: 0.65rem;"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3 mt-2" style="min-width: 220px;">
                        <li class="dropdown-header small fw-bold text-uppercase text-slate">Choose Currency</li>
                        @foreach (var curr in CurrencyService.AvailableCurrencies)
                        {
                            <li>
                                <a class="dropdown-item py-2 small d-flex justify-content-between align-items-center @(curr.Code == CurrencyService.CurrentCode ? "active fw-semibold" : "")" href="javascript:void(0)" onclick="setAppCurrency('@curr.Code')">
                                    <span><strong>@curr.Code</strong> - @curr.Name</span>
                                    <span class="badge @(curr.Code == CurrencyService.CurrentCode ? "bg-white text-dark" : "bg-light text-charcoal border") ms-2">@curr.Symbol</span>
                                </a>
                            </li>
                        }
                    </ul>
                </div>

                @if (SignInManager.IsSignedIn(User))
                {
                    var currentUser = await UserManager.GetUserAsync(User);
                    var unreadNotifications = currentUser != null ? await DbContext.Notifications.CountAsync(n => n.UserId == currentUser.Id && !n.IsRead) : 0;
                    var unreadMessages = currentUser != null ? await DbContext.Messages.CountAsync(m => m.ReceiverId == currentUser.Id && !m.IsRead) : 0;
                    var isSuperAdmin = User.IsInRole("SuperAdmin");
                    var isAdmin = User.IsInRole("Admin");
                    var isHost = User.IsInRole("Host");
                    var isGuest = User.IsInRole("Guest");

                    @if (isGuest)
                    {
                        <!-- Guest Navigation Links -->
                        <a asp-controller="Home" asp-action="Index" class="btn btn-sm btn-link text-decoration-none text-slate d-none d-lg-inline-block">Explore</a>
                        <a asp-controller="Wishlist" asp-action="Index" class="btn btn-sm btn-link text-decoration-none text-slate d-none d-lg-inline-block">
                            <i class="bi bi-heart me-1"></i>Wishlist
                        </a>
                        <a asp-controller="Booking" asp-action="MyTrips" class="btn btn-sm btn-link text-decoration-none text-slate d-none d-lg-inline-block">My Trips</a>
                        <a asp-controller="HostOnboarding" asp-action="Apply" class="btn btn-sm btn-outline-baby d-none d-sm-inline-block">Become a Host</a>
                    }
                    else if (isHost)
                    {
                        <!-- Host Navigation Links -->
                        <span class="badge badge-blue px-2 py-1 small me-1">Host Mode</span>
                        <a asp-controller="Host" asp-action="Index" class="btn btn-sm btn-link text-decoration-none text-slate d-none d-lg-inline-block">Dashboard</a>
                        <a asp-controller="Host" asp-action="Listings" class="btn btn-sm btn-link text-decoration-none text-slate d-none d-lg-inline-block">My Listings</a>
                        <a asp-controller="Host" asp-action="Reservations" class="btn btn-sm btn-link text-decoration-none text-slate d-none d-lg-inline-block">Reservations</a>
                    }
                    else if (isAdmin || isSuperAdmin)
                    {
                        <!-- Admin Navigation Links -->
                        <span class="badge bg-dark px-2 py-1 small me-1">@(isSuperAdmin ? "SuperAdmin" : "Admin")</span>
                        <a asp-controller="Admin" asp-action="Index" class="btn btn-sm btn-link text-decoration-none text-slate d-none d-lg-inline-block">Command Center</a>
                        <a asp-controller="Admin" asp-action="Applications" class="btn btn-sm btn-link text-decoration-none text-slate d-none d-lg-inline-block">Applications</a>
                        @if (isSuperAdmin)
                        {
                            <a asp-controller="SuperAdmin" asp-action="Users" class="btn btn-sm btn-link text-decoration-none text-slate d-none d-lg-inline-block">Users</a>
                        }
                        <a asp-controller="Admin" asp-action="AuditLogs" class="btn btn-sm btn-link text-decoration-none text-slate d-none d-lg-inline-block">Audit Logs</a>
                    }

                    <!-- Notifications Icon with Unread Badge -->
                    <a asp-controller="Notifications" asp-action="Index" class="btn btn-sm btn-light border position-relative rounded-circle p-2 ms-1" title="Notifications">
                        <i class="bi bi-bell text-slate"></i>
                        @if (unreadNotifications > 0)
                        {
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill text-white" style="background-color: var(--accent-pink) !important; font-size: 0.65rem;">
                                @unreadNotifications
                            </span>
                        }
                    </a>

                    <!-- Messages Icon with Unread Badge -->
                    <a asp-controller="Messages" asp-action="Index" class="btn btn-sm btn-light border position-relative rounded-circle p-2 ms-1" title="Messages">
                        <i class="bi bi-chat-dots text-slate"></i>
                        @if (unreadMessages > 0)
                        {
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill text-white" style="background-color: var(--accent-pink) !important; font-size: 0.65rem;">
                                @unreadMessages
                            </span>
                        }
                    </a>

                    <!-- Account Dropdown Menu -->
                    <div class="dropdown ms-2">
                        <button class="btn btn-light border rounded-pill py-1 px-2 d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-list text-slate"></i>
                            <div class="user-avatar-bubble">
                                @(string.IsNullOrEmpty(currentUser?.FirstName) ? "U" : currentUser.FirstName.Substring(0, 1))
                            </div>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3 mt-2">
                            <li class="px-3 py-2 border-bottom">
                                <div class="fw-bold small text-charcoal">@currentUser?.FullName</div>
                                <div class="text-slate small" style="font-size: 0.8rem;">@currentUser?.Email</div>
                            </li>
                            <li><a class="dropdown-item py-2" asp-controller="Account" asp-action="Profile"><i class="bi bi-person me-2"></i>Profile</a></li>
                            <li><a class="dropdown-item py-2" asp-controller="Messages" asp-action="Index"><i class="bi bi-chat-dots me-2"></i>Messages @(unreadMessages > 0 ? $"({unreadMessages})" : "")</a></li>
                            <li><a class="dropdown-item py-2" asp-controller="Notifications" asp-action="Index"><i class="bi bi-bell me-2"></i>Notifications @(unreadNotifications > 0 ? $"({unreadNotifications})" : "")</a></li>
                            @if (isGuest)
                            {
                                <li><a class="dropdown-item py-2" asp-controller="Wishlist" asp-action="Index"><i class="bi bi-heart me-2"></i>Wishlist</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="Booking" asp-action="MyTrips"><i class="bi bi-briefcase me-2"></i>Trips</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item py-2 text-primary fw-semibold" asp-controller="HostOnboarding" asp-action="Apply"><i class="bi bi-house-add me-2"></i>Become a Host</a></li>
                            }
                            else if (isHost)
                            {
                                <li><a class="dropdown-item py-2" asp-controller="Host" asp-action="Index"><i class="bi bi-speedometer2 me-2"></i>Host Dashboard</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="Host" asp-action="Listings"><i class="bi bi-houses me-2"></i>Manage Listings</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="Host" asp-action="Reservations"><i class="bi bi-calendar-check me-2"></i>Reservations</a></li>
                            }
                            else if (isAdmin || isSuperAdmin)
                            {
                                <li><a class="dropdown-item py-2" asp-controller="Admin" asp-action="Index"><i class="bi bi-shield-check me-2"></i>Admin Dashboard</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="Admin" asp-action="Applications"><i class="bi bi-file-earmark-text me-2"></i>Applications</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="Admin" asp-action="AuditLogs"><i class="bi bi-journal-text me-2"></i>Audit Logs</a></li>
                                @if (isSuperAdmin)
                                {
                                    <li><a class="dropdown-item py-2" asp-controller="SuperAdmin" asp-action="Users"><i class="bi bi-people me-2"></i>User Governance</a></li>
                                }
                            }
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                    <button type="submit" class="dropdown-item py-2 text-danger">
                                        <i class="bi bi-box-arrow-right me-2"></i>Log out
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <!-- Unauthenticated Navigation -->
                    <a asp-controller="Home" asp-action="Index" class="btn btn-sm btn-link text-decoration-none text-slate d-none d-sm-inline-block">Explore</a>
                    <a asp-controller="HostOnboarding" asp-action="Apply" class="btn btn-sm btn-link text-decoration-none text-slate d-none d-md-inline-block">Become a Host</a>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1">Log in</a>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-sm btn-primary-baby rounded-pill px-3 py-1">Sign up</a>
                }
            </div>
        </nav>
    </header>

    <!-- Main Content Container -->
    <div class="container-fluid px-md-5 mt-4">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <!-- Secondary Pearl Footer -->
    <footer class="staybnb-footer">
        <div class="container-fluid px-md-5">
            <div class="row g-4 mb-4">
                <div class="col-6 col-md-3">
                    <h6 class="fw-bold text-charcoal mb-3">Support</h6>
                    <ul class="list-unstyled small text-slate d-flex flex-column gap-2 mb-0">
                        <li><a href="#" class="text-decoration-none text-slate">Help Center</a></li>
                        <li><a href="#" class="text-decoration-none text-slate">Safety Information</a></li>
                        <li><a href="#" class="text-decoration-none text-slate">Cancellation Options</a></li>
                    </ul>
                </div>
                <div class="col-6 col-md-3">
                    <h6 class="fw-bold text-charcoal mb-3">Hosting</h6>
                    <ul class="list-unstyled small text-slate d-flex flex-column gap-2 mb-0">
                        <li><a asp-controller="Account" asp-action="Register" class="text-decoration-none text-slate">Staybnb your home</a></li>
                        <li><a href="#" class="text-decoration-none text-slate">Hosting Resources</a></li>
                        <li><a href="#" class="text-decoration-none text-slate">Community Forum</a></li>
                    </ul>
                </div>
                <div class="col-6 col-md-3">
                    <h6 class="fw-bold text-charcoal mb-3">Staybnb</h6>
                    <ul class="list-unstyled small text-slate d-flex flex-column gap-2 mb-0">
                        <li><a href="#" class="text-decoration-none text-slate">Newsroom</a></li>
                        <li><a href="#" class="text-decoration-none text-slate">New features</a></li>
                        <li><a href="#" class="text-decoration-none text-slate">Careers</a></li>
                    </ul>
                </div>
                <div class="col-6 col-md-3">
                    <h6 class="fw-bold text-charcoal mb-3">Student Project</h6>
                    <p class="small text-slate mb-0">Staybnb Airbnb clone developed with ASP.NET Core MVC, Entity Framework Core, and SQL Server / SQLite.</p>
                </div>
            </div>
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center pt-3 border-top border-light-subtle small text-slate">
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <div>&copy; 2026 Staybnb, Inc. All rights reserved.</div>
                    <span>&middot;</span>
                    <div>Developed by <a href="http://fyto-inc.vercel.app/" target="_blank" rel="noopener noreferrer" class="text-decoration-none fw-semibold" style="color: var(--primary-blue);">Fyto Inc.</a></div>
                </div>
                <div class="d-flex align-items-center gap-3 mt-2 mt-sm-0">
                    <!-- Footer Currency Selector -->
                    <div class="dropdown d-inline-block">
                        <button class="btn btn-sm btn-link text-decoration-none text-slate p-0 d-flex align-items-center gap-1 dropdown-toggle" type="button" data-bs-toggle="dropdown">
                            <i class="bi bi-globe me-1"></i>
                            <span class="currency-display-label">@CurrencyService.CurrentCurrency.Code (@CurrencyService.CurrentCurrency.Symbol)</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3">
                            <li class="dropdown-header small fw-bold text-uppercase text-slate">Choose Currency</li>
                            @foreach (var curr in CurrencyService.AvailableCurrencies)
                            {
                                <li>
                                    <a class="dropdown-item py-2 small d-flex justify-content-between align-items-center @(curr.Code == CurrencyService.CurrentCode ? "active fw-semibold" : "")" href="javascript:void(0)" onclick="setAppCurrency('@curr.Code')">
                                        <span><strong>@curr.Code</strong> - @curr.Name</span>
                                        <span class="badge @(curr.Code == CurrencyService.CurrentCode ? "bg-white text-dark" : "bg-light text-charcoal border") ms-2">@curr.Symbol</span>
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                    <a href="#" class="text-decoration-none text-slate">Privacy</a>
                    <a href="#" class="text-decoration-none text-slate">Terms</a>
                    <a href="#" class="text-decoration-none text-slate">Sitemap</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Global Currency Switcher Engine -->
    <script>
        const APP_CURRENCIES = {
            'ZAR': { symbol: 'R', rate: 1.0, label: 'ZAR (R)', name: 'South African Rand' },
            'USD': { symbol: '$', rate: 0.055, label: 'USD ($)', name: 'US Dollar' },
            'EUR': { symbol: '€', rate: 0.051, label: 'EUR (€)', name: 'Euro' },
            'GBP': { symbol: '£', rate: 0.043, label: 'GBP (£)', name: 'British Pound' }
        };

        window.currentCurrencyCode = '@CurrencyService.CurrentCode';
        window.currentCurrencySymbol = '@CurrencyService.CurrentSymbol';
        window.currentCurrencyRate = @CurrencyService.CurrentRate;

        function setAppCurrency(code) {
            if (!APP_CURRENCIES[code]) return;
            const info = APP_CURRENCIES[code];

            window.currentCurrencyCode = code;
            window.currentCurrencySymbol = info.symbol;
            window.currentCurrencyRate = info.rate;

            // Set cookie for 1 year
            document.cookie = "StayBnB_Currency=" + code + ";path=/;max-age=31536000;SameSite=Lax";
            try { localStorage.setItem("staybnb_currency", code); } catch(e) {}

            // Notify server via AJAX
            fetch('/Home/SetCurrency?currency=' + code, {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            }).catch(() => {});

            // Update all price tags across the current view
            document.querySelectorAll('.staybnb-price').forEach(el => {
                const basePrice = parseFloat(el.getAttribute('data-base-price'));
                if (!isNaN(basePrice)) {
                    const converted = basePrice * info.rate;
                    if (code === 'ZAR') {
                        el.innerText = info.symbol + (converted % 1 === 0 ? Math.round(converted).toLocaleString() : converted.toFixed(2));
                    } else {
                        el.innerText = info.symbol + converted.toFixed(2);
                    }
                }
            });

            // Update labels in navbar and footer
            document.querySelectorAll('.currency-display-label').forEach(el => {
                el.innerText = info.label;
            });

            // Trigger dynamic price recalculation if present (e.g. Details page)
            if (typeof updatePriceCalculation === 'function') {
                updatePriceCalculation();
            }
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
