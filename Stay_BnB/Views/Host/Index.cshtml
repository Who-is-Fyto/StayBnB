@model Stay_BnB.ViewModels.Host.HostDashboardViewModel
@{
    ViewData["Title"] = "Host Dashboard";
}

<div class="container py-3">
    <!-- Header banner -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge badge-blue px-3 py-1">Host Mode</span>
                <span class="text-slate small">Welcome back, @Model.HostName</span>
            </div>
            <h1 class="h3 fw-bold text-charcoal m-0">Hosting Dashboard</h1>
            <p class="text-slate small m-0">Oversee your properties, track earnings, and respond to incoming booking requests.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Listings" class="btn btn-outline-secondary rounded-pill px-3 py-2 small">
                <i class="bi bi-houses me-1"></i>Manage Listings
            </a>
            <a asp-action="CreateListing" class="btn btn-primary-baby rounded-pill px-3 py-2 small">
                <i class="bi bi-plus-circle me-1"></i>Add Listing
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 rounded-4 shadow-sm mb-4 alert-dismissible fade show">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger border-0 rounded-4 shadow-sm mb-4 alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["InfoMessage"] != null)
    {
        <div class="alert alert-info border-0 rounded-4 shadow-sm mb-4 alert-dismissible fade show">
            <i class="bi bi-info-circle-fill me-2"></i>@TempData["InfoMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Key Metrics Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card border-0 rounded-4 p-3 shadow-sm h-100" style="background-color: var(--bg-white);">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-slate small fw-semibold">Total Revenue</span>
                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 38px; height: 38px; background-color: var(--primary-blue-light); color: var(--primary-blue);">
                        <i class="bi bi-currency-dollar fs-5"></i>
                    </div>
                </div>
                <div class="h3 fw-bold text-charcoal m-0">$@Model.TotalEarnings.ToString("N2")</div>
                <div class="text-slate small mt-1">From confirmed stays</div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="card border-0 rounded-4 p-3 shadow-sm h-100" style="background-color: var(--bg-white);">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-slate small fw-semibold">Active Listings</span>
                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 38px; height: 38px; background-color: #DCFCE7; color: #16A34A;">
                        <i class="bi bi-check2-circle fs-5"></i>
                    </div>
                </div>
                <div class="h3 fw-bold text-charcoal m-0">@Model.ActiveListings <span class="fs-6 fw-normal text-slate">/ @Model.TotalListings</span></div>
                <div class="text-slate small mt-1">@Model.InactiveListings hidden</div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="card border-0 rounded-4 p-3 shadow-sm h-100" style="background-color: var(--bg-white);">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-slate small fw-semibold">Pending Requests</span>
                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 38px; height: 38px; background-color: var(--accent-pink-light); color: var(--accent-pink);">
                        <i class="bi bi-clock-history fs-5"></i>
                    </div>
                </div>
                <div class="h3 fw-bold text-charcoal m-0">@Model.PendingReservationsCount</div>
                <div class="text-slate small mt-1">Require decision</div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="card border-0 rounded-4 p-3 shadow-sm h-100" style="background-color: var(--bg-white);">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-slate small fw-semibold">Total Bookings</span>
                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 38px; height: 38px; background-color: #EDE9FE; color: #8B5CF6;">
                        <i class="bi bi-calendar-check fs-5"></i>
                    </div>
                </div>
                <div class="h3 fw-bold text-charcoal m-0">@Model.TotalReservations</div>
                <div class="text-slate small mt-1">All time reservations</div>
            </div>
        </div>
    </div>

    <!-- Pending Reservation Requests Queue -->
    <div class="card border-0 rounded-4 shadow-sm mb-4" style="background-color: var(--bg-white);">
        <div class="card-header bg-transparent border-bottom p-3 d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-pink text-white rounded-pill px-2 py-1 small">@Model.PendingReservationsCount</span>
                <h5 class="fw-bold text-charcoal m-0">Incoming Booking Requests</h5>
            </div>
            <a asp-action="Reservations" asp-route-status="Pending" class="btn btn-sm btn-link text-decoration-none text-slate">View All</a>
        </div>
        <div class="card-body p-3">
            @if (!Model.PendingReservations.Any())
            {
                <div class="text-center py-4">
                    <div class="text-slate mb-2"><i class="bi bi-check2-circle fs-1 text-muted"></i></div>
                    <div class="fw-semibold text-charcoal">No pending requests</div>
                    <div class="text-slate small">You have responded to all incoming guest bookings.</div>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr class="text-slate small">
                                <th>Guest</th>
                                <th>Property</th>
                                <th>Dates</th>
                                <th>Guests</th>
                                <th>Total</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var res in Model.PendingReservations)
                            {
                                int nights = (int)(res.CheckOutDate - res.CheckInDate).TotalDays;
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="user-avatar-bubble" style="width: 32px; height: 32px; font-size: 0.85rem;">
                                                @(string.IsNullOrEmpty(res.Guest?.FirstName) ? "G" : res.Guest.FirstName.Substring(0, 1))
                                            </div>
                                            <div>
                                                <div class="fw-semibold text-charcoal small">@res.Guest?.FullName</div>
                                                <div class="text-slate" style="font-size: 0.75rem;">@res.Guest?.Email</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-charcoal small">@res.Property?.Title</div>
                                        <div class="text-slate" style="font-size: 0.75rem;">@res.Property?.City</div>
                                    </td>
                                    <td>
                                        <div class="small text-charcoal fw-semibold">@res.CheckInDate.ToString("MMM dd") - @res.CheckOutDate.ToString("MMM dd, yyyy")</div>
                                        <div class="text-slate" style="font-size: 0.75rem;">@nights night@(nights > 1 ? "s" : "")</div>
                                    </td>
                                    <td>
                                        <span class="small text-charcoal">@res.GuestCount guest@(res.GuestCount > 1 ? "s" : "")</span>
                                    </td>
                                    <td>
                                        <span class="fw-bold text-charcoal small">$@res.TotalPrice.ToString("N2")</span>
                                    </td>
                                    <td class="text-end">
                                        <div class="d-inline-flex gap-1">
                                            <form asp-action="ApproveReservation" asp-route-id="@res.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-primary-baby rounded-pill px-3 py-1 text-white">
                                                    Approve
                                                </button>
                                            </form>
                                            <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 py-1" data-bs-toggle="modal" data-bs-target="#declineModal-@res.Id">
                                                Decline
                                            </button>
                                        </div>

                                        <!-- Decline Modal -->
                                        <div class="modal fade text-start" id="declineModal-@res.Id" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content rounded-4 border-0 shadow">
                                                    <div class="modal-header border-0 pb-0">
                                                        <h5 class="modal-title fw-bold text-charcoal">Decline Reservation</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                    </div>
                                                    <form asp-action="RejectReservation" asp-route-id="@res.Id" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <div class="modal-body py-3">
                                                            <p class="text-slate small mb-3">
                                                                Are you sure you want to decline the reservation request from <strong>@res.Guest?.FullName</strong> for <strong>@res.Property?.Title</strong>?
                                                            </p>
                                                            <div class="mb-3">
                                                                <label class="form-label small fw-semibold text-charcoal">Reason for decline (Optional)</label>
                                                                <textarea name="reason" rows="2" class="form-control rounded-3" placeholder="e.g. Property unavailable for maintenance..."></textarea>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer border-0 pt-0">
                                                            <button type="button" class="btn btn-sm btn-light rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                                                            <button type="submit" class="btn btn-sm btn-danger rounded-pill px-3">Confirm Decline</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- Recent Listings Overview with Quick Toggle -->
    <div class="card border-0 rounded-4 shadow-sm" style="background-color: var(--bg-white);">
        <div class="card-header bg-transparent border-bottom p-3 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold text-charcoal m-0">Your Listings</h5>
            <a asp-action="Listings" class="btn btn-sm btn-link text-decoration-none text-slate">Manage All</a>
        </div>
        <div class="card-body p-3">
            @if (!Model.RecentListings.Any())
            {
                <div class="text-center py-4">
                    <div class="text-slate mb-2"><i class="bi bi-house-door fs-1 text-muted"></i></div>
                    <div class="fw-semibold text-charcoal">No listings published yet</div>
                    <div class="text-slate small mb-3">Add your first property to start hosting guests.</div>
                    <a asp-action="CreateListing" class="btn btn-sm btn-primary-baby rounded-pill px-3">Add Property</a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr class="text-slate small">
                                <th>Property</th>
                                <th>Location</th>
                                <th>Price</th>
                                <th>Capacity</th>
                                <th>Marketplace Visibility</th>
                                <th class="text-end">Manage</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var prop in Model.RecentListings)
                            {
                                var cover = prop.Images.FirstOrDefault(i => i.IsCover)?.ImageUrl 
                                    ?? prop.Images.FirstOrDefault()?.ImageUrl 
                                    ?? "https://images.unsplash.com/photo-1512917774080-9991f1c4c750?auto=format&fit=crop&w=400&q=80";
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <img src="@cover" alt="@prop.Title" class="rounded-3 object-fit-cover" style="width: 56px; height: 42px;" />
                                            <div>
                                                <a asp-controller="Properties" asp-action="Details" asp-route-id="@prop.Id" class="fw-semibold text-charcoal text-decoration-none small">
                                                    @prop.Title
                                                </a>
                                                <div class="text-slate" style="font-size: 0.75rem;">@prop.PropertyType</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="small text-charcoal">@prop.City</div>
                                    </td>
                                    <td>
                                        <span class="fw-semibold text-charcoal small staybnb-price" data-base-price="@prop.PricePerNight">@CurrencyService.Format(prop.PricePerNight)</span>
                                        <span class="text-slate" style="font-size: 0.75rem;">/ night</span>
                                    </td>
                                    <td>
                                        <span class="small text-slate">Up to @prop.MaxGuests guests</span>
                                    </td>
                                    <td>
                                        <form asp-action="ToggleActive" asp-route-id="@prop.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            @if (prop.IsActive)
                                            {
                                                <button type="submit" class="btn btn-sm rounded-pill px-2 py-0 border-0" style="background-color: #DCFCE7; color: #16A34A; font-size: 0.75rem;" title="Click to hide from search">
                                                    <i class="bi bi-eye me-1"></i>Active
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-sm rounded-pill px-2 py-0 border-0" style="background-color: #FEE2E2; color: #DC2626; font-size: 0.75rem;" title="Click to show in search">
                                                    <i class="bi bi-eye-slash me-1"></i>Hidden
                                                </button>
                                            }
                                        </form>
                                    </td>
                                    <td class="text-end">
                                        <div class="d-inline-flex gap-1">
                                            <a asp-action="EditListing" asp-route-id="@prop.Id" class="btn btn-sm btn-light rounded-pill px-2 py-1" title="Edit Listing">
                                                <i class="bi bi-pencil text-slate"></i>
                                            </a>
                                            <a asp-action="ManageImages" asp-route-id="@prop.Id" class="btn btn-sm btn-light rounded-pill px-2 py-1" title="Manage Photos">
                                                <i class="bi bi-images text-slate"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
