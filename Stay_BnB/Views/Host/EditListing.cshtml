@model Stay_BnB.ViewModels.Host.EditListingViewModel
@{
    ViewData["Title"] = "Edit Listing";
}

<div class="container py-3">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <!-- Back navigation -->
            <div class="mb-3">
                <a asp-action="Listings" class="text-decoration-none text-slate small">
                    <i class="bi bi-chevron-left me-1"></i>Back to Listings
                </a>
            </div>

            <!-- Edit Form Card -->
            <div class="card border-0 rounded-4 shadow-sm p-4 p-md-5" style="background-color: var(--bg-white);">
                <div class="d-flex justify-content-between align-items-start mb-4">
                    <div>
                        <span class="badge badge-blue px-3 py-1 mb-2">Edit Listing</span>
                        <h2 class="h3 fw-bold text-charcoal m-0">@Model.Title</h2>
                        <p class="text-slate small m-0">Update your listing details, nightly rate, and amenities.</p>
                    </div>
                    <div>
                        <a asp-action="ManageImages" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-2">
                            <i class="bi bi-images me-1"></i>Manage Photos (@Model.Images.Count)
                        </a>
                    </div>
                </div>

                <form asp-action="EditListing" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small"></div>

                    <!-- 1. Basics -->
                    <div class="border-bottom pb-4 mb-4">
                        <h5 class="fw-bold text-charcoal mb-3">1. Listing Basics</h5>

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label small fw-semibold text-charcoal"></label>
                            <input asp-for="Title" class="form-control rounded-3" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label small fw-semibold text-charcoal"></label>
                            <textarea asp-for="Description" rows="5" class="form-control rounded-3"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="PropertyType" class="form-label small fw-semibold text-charcoal"></label>
                                <select asp-for="PropertyType" class="form-select rounded-3">
                                    <option value="Apartment">Apartment</option>
                                    <option value="House">House</option>
                                    <option value="Villa">Villa</option>
                                    <option value="Cottage">Cottage</option>
                                    <option value="Cabin">Cabin</option>
                                    <option value="Loft">Loft</option>
                                </select>
                                <span asp-validation-for="PropertyType" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="MaxGuests" class="form-label small fw-semibold text-charcoal"></label>
                                <input asp-for="MaxGuests" type="number" min="1" max="30" class="form-control rounded-3" />
                                <span asp-validation-for="MaxGuests" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <!-- 2. Location -->
                    <div class="border-bottom pb-4 mb-4">
                        <h5 class="fw-bold text-charcoal mb-3">2. Location</h5>
                        <div class="row g-3">
                            <div class="col-md-8">
                                <label asp-for="Address" class="form-label small fw-semibold text-charcoal"></label>
                                <input asp-for="Address" class="form-control rounded-3" />
                                <span asp-validation-for="Address" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="City" class="form-label small fw-semibold text-charcoal"></label>
                                <input asp-for="City" class="form-control rounded-3" />
                                <span asp-validation-for="City" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <!-- 3. Pricing -->
                    <div class="border-bottom pb-4 mb-4">
                        <h5 class="fw-bold text-charcoal mb-3">3. Pricing</h5>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label asp-for="PricePerNight" class="form-label small fw-semibold text-charcoal"></label>
                                <div class="input-group">
                                    <span class="input-group-text currency-symbol">@CurrencyService.CurrentSymbol</span>
                                    <input asp-for="PricePerNight" type="number" step="0.01" class="form-control rounded-end-3" />
                                </div>
                                <span asp-validation-for="PricePerNight" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="CleaningFee" class="form-label small fw-semibold text-charcoal"></label>
                                <div class="input-group">
                                    <span class="input-group-text currency-symbol">@CurrencyService.CurrentSymbol</span>
                                    <input asp-for="CleaningFee" type="number" step="0.01" class="form-control rounded-end-3" />
                                </div>
                                <span asp-validation-for="CleaningFee" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="ServiceFee" class="form-label small fw-semibold text-charcoal"></label>
                                <div class="input-group">
                                    <span class="input-group-text currency-symbol">@CurrencyService.CurrentSymbol</span>
                                    <input asp-for="ServiceFee" type="number" step="0.01" class="form-control rounded-end-3" />
                                </div>
                                <span asp-validation-for="ServiceFee" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <!-- 4. Marketplace Visibility -->
                    <div class="border-bottom pb-4 mb-4">
                        <h5 class="fw-bold text-charcoal mb-2">4. Visibility Status</h5>
                        <div class="form-check form-switch p-2">
                            <input class="form-check-input ms-0 me-3" type="checkbox" asp-for="IsActive" role="switch" id="activeSwitch" style="width: 2.5em; height: 1.3em;">
                            <label class="form-check-label text-charcoal fw-semibold" for="activeSwitch">
                                Active in search results
                            </label>
                            <div class="text-slate small ps-5">When disabled, travelers will not be able to find or book this property.</div>
                        </div>
                    </div>

                    <!-- 5. Amenities -->
                    <div class="mb-4">
                        <h5 class="fw-bold text-charcoal mb-3">5. Amenities</h5>
                        <div class="row g-2">
                            @foreach (var amenity in Model.AvailableAmenities)
                            {
                                bool isChecked = Model.SelectedAmenityIds.Contains(amenity.Id);
                                <div class="col-6 col-md-4">
                                    <div class="form-check p-2 border rounded-3 h-100 d-flex align-items-center">
                                        <input class="form-check-input ms-0 me-2" type="checkbox" name="SelectedAmenityIds" value="@amenity.Id" id="amenity-@amenity.Id" @(isChecked ? "checked" : "") />
                                        <label class="form-check-label text-charcoal small" for="amenity-@amenity.Id">
                                            <i class="@amenity.IconClass text-slate me-1"></i>@amenity.Name
                                        </label>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a asp-action="Listings" class="btn btn-light rounded-pill px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary-baby rounded-pill px-5 text-white">
                            Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
