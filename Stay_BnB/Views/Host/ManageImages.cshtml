@model Stay_BnB.ViewModels.Host.ManageImagesViewModel
@{
    ViewData["Title"] = "Manage Photos - " + Model.PropertyTitle;
}

<div class="container py-3">
    <!-- Back navigation -->
    <div class="mb-3">
        <a asp-action="Listings" class="text-decoration-none text-slate small">
            <i class="bi bi-chevron-left me-1"></i>Back to Listings
        </a>
    </div>

    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <span class="badge badge-blue px-3 py-1 mb-2">Photo Gallery</span>
            <h1 class="h3 fw-bold text-charcoal m-0">@Model.PropertyTitle</h1>
            <p class="text-slate small m-0">Manage listing photography, select your primary cover photo, and add new high-resolution images.</p>
        </div>
        <div>
            <a asp-action="EditListing" asp-route-id="@Model.PropertyId" class="btn btn-outline-secondary rounded-pill px-3 py-2 small">
                <i class="bi bi-pencil me-1"></i>Edit Listing Details
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 rounded-4 shadow-sm mb-4 alert-dismissible fade show">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger border-0 rounded-4 shadow-sm mb-4 alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Current Photos Grid -->
    <div class="card border-0 rounded-4 shadow-sm p-4 mb-4" style="background-color: var(--bg-white);">
        <h5 class="fw-bold text-charcoal mb-3">Current Photos (@Model.Images.Count)</h5>
        <div class="row g-3">
            @foreach (var img in Model.Images)
            {
                <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                    <div class="card border-0 rounded-4 overflow-hidden shadow-sm h-100 position-relative">
                        <img src="@img.ImageUrl" alt="Property image" class="w-100 object-fit-cover" style="height: 180px;" />

                        <!-- Cover Photo Badge -->
                        @if (img.IsCover)
                        {
                            <span class="position-absolute top-0 start-0 m-2 badge bg-primary-baby text-white rounded-pill px-2 py-1 shadow-sm small">
                                <i class="bi bi-star-fill me-1"></i>Cover Photo
                            </span>
                        }

                        <div class="card-body p-2 d-flex justify-content-between align-items-center bg-white border-top">
                            @if (!img.IsCover)
                            {
                                <form asp-action="SetCoverImage" method="post" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="propertyId" value="@Model.PropertyId" />
                                    <input type="hidden" name="imageId" value="@img.Id" />
                                    <button type="submit" class="btn btn-sm btn-link text-decoration-none text-slate p-0 small">
                                        <i class="bi bi-star me-1"></i>Set Cover
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="text-slate small fw-semibold">Primary Cover</span>
                            }

                            @if (Model.Images.Count > 1)
                            {
                                <form asp-action="DeleteImage" method="post" class="m-0" onsubmit="return confirm('Are you sure you want to delete this photo?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="propertyId" value="@Model.PropertyId" />
                                    <input type="hidden" name="imageId" value="@img.Id" />
                                    <button type="submit" class="btn btn-sm btn-link text-danger p-0" title="Delete photo">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Upload More Photos -->
    <div class="card border-0 rounded-4 shadow-sm p-4" style="background-color: var(--bg-white);">
        <h5 class="fw-bold text-charcoal mb-2">Upload Additional Photos</h5>
        <p class="text-slate small mb-3">Add more interior, exterior, and amenity photos to attract travelers.</p>

        <form asp-action="AddImages" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" name="propertyId" value="@Model.PropertyId" />

            <div class="p-4 border border-2 border-dashed rounded-4 text-center mb-3" style="background-color: var(--bg-pearl);">
                <i class="bi bi-cloud-arrow-up fs-1 text-slate mb-2"></i>
                <div class="fw-semibold text-charcoal small mb-1">Select additional photos</div>
                <div class="text-slate small mb-3">PNG, JPG, or WEBP up to 10MB each</div>
                <input type="file" name="photos" multiple accept="image/*" class="form-control rounded-3 mx-auto" style="max-width: 400px;" required />
            </div>

            <div class="d-flex justify-content-end">
                <button type="submit" class="btn btn-primary-baby rounded-pill px-4 text-white">
                    <i class="bi bi-upload me-1"></i>Upload Photos
                </button>
            </div>
        </form>
    </div>
</div>
