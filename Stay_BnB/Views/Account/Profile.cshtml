@model Stay_BnB.ViewModels.Account.ProfileViewModel
@{
    ViewData["Title"] = "User Profile";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-7 col-lg-6">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="fw-bold mb-0">Your Profile</h3>
                    <span class="badge bg-danger fs-6 px-3 py-2">@Model.CurrentRole</span>
                </div>

                @if (ViewBag.SuccessMessage != null)
                {
                    <div class="alert alert-success py-2 small">@ViewBag.SuccessMessage</div>
                }

                <form asp-action="Profile" method="post">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted">Email (Username)</label>
                        <input class="form-control bg-light" value="@Model.Email" readonly />
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label asp-for="FirstName" class="form-label small fw-semibold"></label>
                            <input asp-for="FirstName" class="form-control" />
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LastName" class="form-label small fw-semibold"></label>
                            <input asp-for="LastName" class="form-control" />
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ProfilePictureUrl" class="form-label small fw-semibold">Profile Photo URL</label>
                        <input asp-for="ProfilePictureUrl" class="form-control" placeholder="https://example.com/avatar.jpg" />
                        <span asp-validation-for="ProfilePictureUrl" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-semibold text-muted">Member Since</label>
                        <div class="small text-muted">@Model.CreatedAt.ToString("MMMM dd, yyyy")</div>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary px-3">Back to Home</a>
                        <button type="submit" class="btn btn-danger px-4">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
