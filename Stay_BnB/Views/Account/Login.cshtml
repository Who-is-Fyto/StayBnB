@model Stay_BnB.ViewModels.Account.LoginViewModel
@{
    ViewData["Title"] = "Log in to Staybnb";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-body p-4">
                <h3 class="card-title text-center fw-bold mb-1">Welcome Back</h3>
                <p class="text-muted text-center small mb-4">Log in with your Staybnb credentials.</p>

                <form asp-action="Login" method="post">
                    <input type="hidden" asp-for="ReturnUrl" />
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label small fw-semibold"></label>
                        <input asp-for="Email" class="form-control" placeholder="name@example.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label small fw-semibold"></label>
                        <input asp-for="Password" class="form-control" placeholder="Your password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label small"></label>
                    </div>

                    <div class="d-grid mt-4">
                        <button type="submit" class="btn btn-danger btn-lg py-2 fw-semibold">Log In</button>
                    </div>
                </form>

                <div class="text-center mt-3 small">
                    Don't have an account? <a asp-action="Register" class="text-danger text-decoration-none fw-semibold">Sign up</a>
                </div>

                <div class="mt-4 p-3 bg-light rounded small border">
                    <div class="fw-bold mb-1 text-secondary">Demo Accounts:</div>
                    <ul class="list-unstyled mb-0 text-muted" style="font-size: 0.85rem;">
                        <li><strong>SuperAdmin:</strong> superadmin@staybnb.com / SuperAdmin123!</li>
                        <li><strong>Admin:</strong> admin@staybnb.com / Admin123!</li>
                        <li><strong>Host:</strong> host@staybnb.com / Host123!</li>
                        <li><strong>Guest:</strong> guest@staybnb.com / Guest123!</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
